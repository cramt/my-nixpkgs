# The two npm tools behind t3code's Device panel: expo-device-hub (streams and
# drives emulators/simulators) and agent-device (lets agents use them). Upstream
# `npm install`s each one into <T3CODE_HOME>/tools/<name>/<version>/ the first
# time the panel is enabled (apps/server/src/device/DeviceToolchain.ts). Here
# they are built from committed lockfiles instead, laid out the same way, so a
# consumer symlinks each <name>/<version> into place and the server finds them
# installed: it checks for the entry file plus a `.install-complete` sentinel
# holding the version, and its pruner skips anything that isn't a real
# directory, so a store symlink is never touched.
#
# The versions come from t3code's own deviceToolVersions.json and the lockfiles
# are regenerated by t3code's update.sh, so the two can't drift: a lockfile for
# any other version fails the build below.
{
  lib,
  stdenvNoCC,
  importNpmLock,
  nodejs_24,
  autoPatchelfHook,
  stdenv,
  symlinkJoin,
  src,
}: let
  required = lib.importJSON "${src}/apps/server/src/device/deviceToolVersions.json";

  tool = name: let
    npmRoot = ./device-tools/${name};
    locked = (lib.importJSON "${npmRoot}/package-lock.json").packages."node_modules/${name}".version;
    version = required.${name};
    nodeModules = importNpmLock.buildNodeModules {
      inherit npmRoot;
      nodejs = nodejs_24;
    };
  in
    assert lib.assertMsg (locked == version) ''
      t3code-device-tools: ${name} is locked at ${locked} but t3code wants ${version}.
      Run `nix run .#update -- t3code` to regenerate packages/t3code/device-tools/.
    '';
      stdenvNoCC.mkDerivation {
        pname = "t3code-${name}";
        inherit version;
        dontUnpack = true;
        # node-datachannel's prebuilt addon links libstdc++.
        nativeBuildInputs = [autoPatchelfHook];
        buildInputs = [stdenv.cc.cc.lib];
        installPhase = ''
          dir=$out/${name}/${version}
          mkdir -p $dir
          cp -r ${nodeModules}/node_modules $dir/node_modules
          chmod -R u+w $dir
          # Prebuilt addons for every other OS ride along in the lockfile;
          # autoPatchelf would choke on the musl ones.
          find $dir/node_modules/@node-datachannel -mindepth 1 -maxdepth 1 \
            ! -name '${
            if stdenv.hostPlatform.isAarch64
            then "linux-arm64-gnu"
            else "linux-x64-gnu"
          }' -exec rm -rf {} + 2>/dev/null || true
          echo ${version} > $dir/.install-complete
        '';
      };
in
  symlinkJoin {
    pname = "t3code-device-tools";
    version = "${required.expo-device-hub}+${required.agent-device}";
    paths = map tool ["expo-device-hub" "agent-device"];
    passthru.versions = required;
    meta.platforms = lib.platforms.linux;
  }
